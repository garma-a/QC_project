    "scripts": {
        "build": "bun --bun nest build",
        "format": "bunx prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "bun --bun nest start",
        "start:dev": "bun --bun nest start --watch",
        "start:debug": "bun --bun nest start --debug --watch",
        "start:prod": "bun dist/main.js",
        "lint": "bunx eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
