# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=qc_project
DB_USER=postgres
DB_PASSWORD=postgres

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET="your-strong-jwt-secret-here"
JWT_REFRESH_SECRET="your-strong-jwt-refresh-secret-here"
JWT_REFRESH_EXPIRES_IN=7d

# ─── Email / SMTP ────────────────────────────────────────────────────────────
#
# Option A — DEV MODE (Ethereal, zero setup)
#   Leave SMTP_HOST blank or set SMTP_DEV_MODE=true.
#   An Ethereal catch-all inbox is created automatically on startup.
#   OTP preview URLs are printed to the backend console.
#
SMTP_DEV_MODE=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QC System <noreply@myghc-lab.local>"

# Option B — Mailhog (local Docker, has web UI at http://localhost:8025)
#   docker run -d -p 1025:1025 -p 8025:8025 mailhog/mailhog
#
# SMTP_DEV_MODE=false
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Option C — Gmail (production-like, needs App Password)
#   Create App Password at: https://myaccount.google.com/apppasswords
#
# SMTP_DEV_MODE=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM="QC System <your-address@gmail.com>"

# Option D — SendGrid / Brevo / any transactional provider
#
# SMTP_DEV_MODE=false
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key
# SMTP_FROM="QC System <noreply@yourdomain.com>"

# ─── Frontend URL (used in email links) ─────────────────────────────────────
FRONTEND_URL=http://localhost:3000
